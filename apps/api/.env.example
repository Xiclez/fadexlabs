# Copia a .env para desarrollo local. En k3s estos valores van en un Secret/ConfigMap.
FADEX_ENV=dev
FADEX_PUBLIC_URL=http://localhost:3000
FADEX_CORS_ORIGINS=["http://localhost:3000"]
FADEX_DATABASE_URL=postgresql+asyncpg://fadex:fadex@localhost:5432/fadex
FADEX_REDIS_URL=redis://localhost:6379/0
FADEX_COOKIE_SECURE=false

# Producción: genera el par Ed25519 con  python scripts/gen_jwt_keys.py
# FADEX_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# SMTP (puerto 2525: Telmex bloquea el 25)
FADEX_SMTP_HOST=
FADEX_SMTP_PORT=2525
FADEX_SMTP_USER=
FADEX_SMTP_PASSWORD=

# ---------- Herramientas de la beta (API y worker comparten estas variables) ----------
# Carpeta de subidas y resultados. Sin Docker: corre el worker desde apps/api para que use la misma.
FADEX_DATA_DIR=./data
# Tracklist ID (solo el worker). Sin token se usa solo Shazam.
# ACRCLOUD_TOKEN=
# DJ Library Upgrader (solo el worker): slskd propio y entrega por Google Drive con rclone.
FADEX_SLSKD_URL=http://localhost:5030
FADEX_SLSKD_API_KEY=
# FADEX_SLSKD_DOWNLOADS_DIR=        # por defecto <FADEX_DATA_DIR>/slskd/downloads
# FADEX_RCLONE_REMOTE=gdrive:FADEX/Entregas
